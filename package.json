{
  "name": "carrier-test-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --include .env server/src/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "archiver": "7.0.1",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/pg": "^8.11.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
