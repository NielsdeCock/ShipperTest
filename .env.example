# Monta REST API v6 — base URL without trailing slash
MONTA_API_BASE=https://api-v6.monta.nl
# REST API user (HTTP Basic auth). Create one in the Monta portal under API users.
MONTA_USER=testshippertestMONTATEST
MONTA_PASSWORD=H$RDU$3$0VXX
# Optional: use a bearer token instead of user/password (leave empty for Basic auth)
MONTA_TOKEN=

# Safety gate: real (non-dry) runs are refused unless this is true
ALLOW_LIVE=false

# Postgres connection, e.g. postgres://user:pass@localhost:5432/carrier_test
# Leave empty to use the embedded PGlite database (no install needed).
# PGLITE_DIR empty = %LOCALAPPDATA%/carrier-test-portal/pglite. Do NOT put it inside OneDrive.
DATABASE_URL=
PGLITE_DIR=

PORT=3001
# Where label files are saved: <LABELS_DIR>/<runId>/<orderNumber>.pdf
LABELS_DIR=labels
